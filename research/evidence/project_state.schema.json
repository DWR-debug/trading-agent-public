{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": [
    "schema_version",
    "repository",
    "master_commit",
    "latest_formal_trial",
    "latest_trial_status",
    "safety",
    "agent_usage"
  ],
  "properties": {
    "schema_version": {
      "type": "string"
    },
    "repository": {
      "type": "string",
      "const": "DWR-debug/trading-agent-public"
    },
    "master_commit": {
      "type": "string",
      "pattern": "^[0-9a-f]{40}$"
    },
    "latest_formal_trial": {
      "type": "string"
    },
    "latest_trial_status": {
      "type": "string"
    },
    "safety": {
      "type": "object",
      "required": [
        "paper_only",
        "live_trading_enabled",
        "orders_enabled"
      ]
    },
    "agent_usage": {
      "type": "object",
      "required": [
        "paid_api_budget_usd",
        "auto_paid_api_calls",
        "free_credit_only"
      ]
    }
  }
}
