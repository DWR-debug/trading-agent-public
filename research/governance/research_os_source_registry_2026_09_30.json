{
  "schema_version": "1.0",
  "research_os_version": "ROS-0.1",
  "generated_date": "2026-09-30",
  "purpose": "Capability and source lattice for the Trading Agent Research Operating System. This registry is architectural metadata only; it does not authorize performance evaluation, promotion, live trading, or holdout use.",
  "safety": {
    "paper_only": true,
    "live_trading_enabled": false,
    "orders_enabled": false,
    "automatic_promotion": false,
    "paid_resources_allowed": false
  },
  "operating_principles": [
    "source-first",
    "point-in-time-by-construction",
    "fail-closed provenance",
    "deterministic compute is authoritative",
    "AI is adversarial/research assistance, never scientific evidence by itself",
    "no silent source substitution",
    "immutable receipt before interpretation",
    "anti_convergence_in_hypothesis_generation",
    "schedule research by information_gain_per_compute and falsifiability, never by observed holdout performance"
  ],
  "layers": [
    {
      "id": "L0",
      "name": "Source fabric",
      "role": "Public/official market, macro, regulatory, news and alternative-data acquisition with release-time metadata."
    },
    {
      "id": "L1",
      "name": "Evidence bus",
      "role": "Normalized immutable receipts: source URL, retrieval time, publication/availability time, raw fingerprint, parser version, PIT status.",
      "operational_contract": "automation/research_os_evidence_bus.py"
    },
    {
      "id": "L2",
      "name": "Research compiler",
      "role": "Turn a frozen mechanism into preregistration, coverage/PIT contracts, reproducible input bundle and one-shot performance authorization request."
    },
    {
      "id": "L3",
      "name": "Agent mesh",
      "role": "Multiple narrow agents/providers for discovery, adversarial review, code QA and synthesis; no agent can create scientific evidence directly."
    },
    {
      "id": "L4",
      "name": "Execution/sandbox boundary",
      "role": "Policy-controlled workspaces, network allowlists, endpoint-bound credentials and explicit human approval for elevated actions."
    },
    {
      "id": "L5",
      "name": "Decision/evidence ledger",
      "role": "Trial Ledger, immutable reconciliation, evidence fingerprints and controlled candidate-state transitions."
    }
  ],
