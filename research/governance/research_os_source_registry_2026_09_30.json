  "highest_value_new_paths": [
    {
      "family": "SEC/FINRA short-flow convergence",
      "mechanisms": [
        "FTD",
        "short_interest",
        "RegSHO_daily_volume"
      ],
      "gate": "source/PIT first",
      "why": "Three complementary public channels can express crowding and settlement pressure at different frequencies without buying a proprietary short-flow feed."
    },
    {
      "family": "Macro-vintage regime layer",
      "mechanisms": [
        "ALFRED vintage features",
        "BLS release-aware series",
        "BIS slow-credit states",
        "EIA energy states"
      ],
      "gate": "vintage/release-time contract before any performance",
      "why": "Creates a genuine information-timing layer rather than another price transform."
    },
    {
      "family": "Retail-attention shock",
      "mechanisms": [
        "Nasdaq RTAT10",
        "GDELT event clustering",
        "SEC filing bursts"
      ],
      "gate": "selection/publication-time bias audit",
      "why": "Combines independent attention channels and can be tested as event-state transitions instead of generic sentiment."
    },
    {
      "family": "Agent governance fabric",
      "mechanisms": [
        "MCP resource/tool contracts",
        "A2A specialist handoff",
        "OpenShell-like policy boundary"
      ],
      "gate": "security/contract tests",
      "why": "Turns the project control plane into a capability-driven OS without allowing agent autonomy to become scientific authority."
    },
    {
      "family": "community-data discovery quarantine",
      "mechanisms": [
        "Hugging Face finance/market datasets",
        "public research corpora"
      ],
      "gate": "dataset provenance/license/version/PIT audit",
      "why": "A broad discovery pool can expose unusual data that official APIs do not expose, while a quarantine boundary prevents community data from entering formal evidence without verification."
    }
  ],
  "resource_scheduler": {
    "allowed_axes": [
      "information_gain_per_compute",
      "cheap_falsifiability",
      "source_quality",
      "pit_feasibility",
      "resource_cost",
      "mechanism_novelty_distance",
      "expected_reproducibility"
    ],
    "forbidden_axes": [
      "holdout_return",
      "holdout_drawdown",
      "performance_rank",
      "future_information",
      "candidate_preference"
    ],
    "lane_policy": "Use at most two deterministic research lanes concurrently; reserve one lane for adversarial or governance work when a performance-sensitive chain is active.",
    "ai_policy": "Use provider diversity as an adversarial instrument. Consensus is not evidence and disagreement is not a failure condition by itself.",
    "runtime_artifacts": [
      "research/runs/self_hosted/autonomous/**/research_os_resource_schedule.json",
      "research/runs/self_hosted/autonomous/**/research_os_source_probe.json"
    ],
    "optional_worker_resources": [
      {
