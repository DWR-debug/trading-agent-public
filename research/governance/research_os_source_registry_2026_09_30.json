        "performance_authorization": false,
        "candidate_selection": false,
        "candidate_ranking": false,
        "promotion": false,
        "paid_usage_allowed": false
      }
    ]
  },
  "knowledge_plane": {
    "idea": "Treat papers, methods, source documentation and benchmark reports as versioned machine-readable research resources, while preserving source claims separately from replicated findings.",
    "inspiration": "Paper2Agent demonstrates turning scientific papers into MCP resources for methods and data.",
    "formal_evidence_allowed": "false",
    "source_url": "https://www.nature.com/articles/s41586-026-11044-y"
  },
  "source_probe_policy": {
