{
  "schema_version": "1.0",
  "record_type": "persistent_literature_research_policy",
  "status": "ACTIVE",
  "effective_date_utc": "2026-10-10",
  "purpose": "Continuously discover high-value scientific mechanisms and public information channels without allowing discovery to bypass PIT, robustness, performance or safety gates.",
  "source_scope": {
    "free_access_only": true,
    "include_classes": [
      "open_access_peer_reviewed_literature",
      "preprints_working_papers_dissertations_conference_papers",
      "public_research_technical_regulatory_and_standards_documents",
      "public_blogs_essays_and_research_notes",
      "public_github_repositories_readmes_issues_and_pull_requests",
      "public_data_portals_and_documentation",
      "other_legally_accessible_public_web_sources"
    ],
    "paywalled_only_sources_excluded": true,
    "license_and_terms_must_allow_access": true,
    "exhaustiveness": "broad_continuous_discovery; not a claim of exhaustive coverage of every free source"
  },
  "cadence": {
    "assistant_daily_literature_radar": "daily",
    "assistant_weekly_deep_research": "weekly",
    "repository_public_metadata_scout": "every_6_hours",
    "public_web_blog_repo_discovery": "every_6_hours",
    "research_round_chaining": "after bounded rounds when prerequisites are satisfied"
  },
  "search_axes": [
    "information_arrival_and_latency",
    "information_breadth_and_network_propagation",
    "semantic_content_and_novelty",
    "belief_disagreement_and_heterogeneous_interpretation",
    "market_microstructure_and_price_discovery",
    "institutional_ownership_and_allocator_behavior",
    "public_data_revisions_and_vintages",
    "corporate_event_sequences_and_correction_lineage",
    "innovation_patent_and_technology_networks",
    "unexpected_public_domain_information_channels",
    "risk_state_and_forward_covariance_information",
    "cross_channel_observability_and_redundancy",
    "macro_vintage_revision_reliability",
    "administrative_to_issuer_information_bridges"
  ],
  "selection_rule": {
    "required_dimensions": [
      "mechanism_novelty",
      "orthogonality_to_existing_lineages",
      "cheap_falsifiability",
      "source_quality",
      "historical_pit_feasibility",
      "entity_mapping_feasibility",
      "revision_lineage_feasibility",
      "independent_reproducibility",
      "expected_information_gain_per_compute"
    ],
    "shortlist_maximum": 3,
    "priority_order": [
      "orthogonal_information_advantage",
      "cheap_falsification",
      "historical_pit_feasibility",
      "reproducibility",
      "economic_plausibility"
    ],
    "anti_convergence": "Only develop or dispatch the active allow-list during the focus lock. Do not create or dispatch new candidate families; within these three, prioritize orthogonal information advantages and cheap falsification.",
    "candidate_creation_during_focus_lock": false,
    "active_candidate_allowlist": [
      "Q104:I19",
      "Q220",
      "Q218"
    ]
  },
  "discovery_boundary": {
    "source_claims_are_not_project_evidence": true,
    "performance_authorized": false,
    "holdout_selection_allowed": false,
    "ranking_allowed": false,
    "parameter_search_allowed": false,
    "asset_search_allowed": false,
    "threshold_search_allowed": false,
    "horizon_search_allowed": false,
    "promotion_allowed": false,
    "live_execution_allowed": false
  },
  "pit_rule": "For every actionable mechanism preserve the earliest defensible public-information boundary separately from later process, revision and observation timestamps.",
  "negative_evidence_rule": "Persist PRUNED, UNVERIFIED and DATA_INSUFFICIENT outcomes with reasons so automated search does not repeatedly reopen failed or weakly tractable paths.",
  "candidate_flow": [
    "verify_current_receipts_for_active_candidates",
    "recover_or_close_Q104_I19_historical_13F_census",
    "cheap_falsify_Q220_as_filed_XBRL_representation_gap",
    "avoid_duplicate_Q218_work_when_exact_receipt_fingerprints_match",
    "persist_negative_evidence",
    "independent_PIT_reproduction_only_after_positive_prerequisites"
  ],
  "safety": {
    "PAPER_ONLY": true,
    "LIVE_TRADING_ENABLED": false,
    "ORDERS_ENABLED": false,
    "AUTOMATIC_PROMOTION": false,
    "paid_resources_allowed": false
  },
  "active_candidate_allowlist": [
